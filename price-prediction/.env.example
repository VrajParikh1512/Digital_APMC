# LightGBM model artifacts directory
AGMARKNET_MODEL_DIR=./artifacts

# Optional: protect /admin/reload-model endpoint
# AGMARKET_ADMIN_TOKEN=your_secret_token_here

# MongoDB connection (only needed for daily_retrain_from_mongodb.py)
# Use the same database as backend/.env (the collection created by the Node import is "marketprices")
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=digital_apmc
# MONGODB_COLLECTION=marketprices

# Optional: MongoDB field name overrides (defaults already match backend/models/MarketPrice.js)
# MONGO_FIELD_STATE=state
# MONGO_FIELD_DISTRICT=district
# MONGO_FIELD_MARKET=market
# MONGO_FIELD_COMMODITY_GROUP=commodity_group
# MONGO_FIELD_COMMODITY=commodity
# MONGO_FIELD_DATE=date
# MONGO_FIELD_ARRIVAL=arrival_qty
# MONGO_FIELD_MIN_PRICE=min_price
# MONGO_FIELD_MODAL_PRICE=modal_price
# MONGO_FIELD_MAX_PRICE=max_price
# MONGO_FIELD_PRICE_UNIT=price_unit

# Training parameters (for daily_retrain_from_mongodb.py)
# AGMARKNET_HALF_LIFE_DAYS=180
# AGMARKNET_LIGHTGBM_ROUNDS=160
# AGMARKNET_LIGHTGBM_THREADS=4
# AGMARKET_TRAINING_CAPACITY=30000000

# Set to true if ALL records in the collection are already in Rs./Quintal
# (skips unit field check)
# AGMARKNET_ASSUME_QUINTAL_ONLY=false

