# Copy this file to .env and fill in the values

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/digital_apmc

# Any long random text. Used to sign login tokens.
JWT_SECRET=change_this_to_a_long_random_text

PORT=5000

# Shared secret between the backend and notification-service (use the same value in both .env files)
INTERNAL_API_KEY=change_this_too

# Python price-prediction service (the backend starts it automatically if it is not running)
PREDICT_API_URL=http://127.0.0.1:8000
# PYTHON_EXECUTABLE=python

# Used by:  npm run create-admin
# ADMIN_NAME=Admin
# ADMIN_PHONE=9999999999
# ADMIN_PASSWORD=admin123
